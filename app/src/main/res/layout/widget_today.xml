<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget: today's person + one WhatsApp button (or "no one today"). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:layoutDirection="rtl"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/widget_person"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/ibm_plex_arabic_bold"
            android:maxLines="1"
            android:textColor="#E4ECE9"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/ibm_plex_arabic_regular"
            android:maxLines="1"
            android:textColor="#A7B6B1"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_whatsapp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/widget_button"
            android:fontFamily="@font/ibm_plex_arabic_bold"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="واتساب"
            android:textColor="#0B2A1F"
            android:textSize="15sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="@font/ibm_plex_arabic_medium"
        android:gravity="center"
        android:text="لا أحد اليوم"
        android:textColor="#A7B6B1"
        android:textSize="16sp"
        android:visibility="gone" />
</FrameLayout>
